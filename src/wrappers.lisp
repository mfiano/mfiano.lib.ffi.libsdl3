(defun update-texture/from-array (texture width height data &key rect (x 0) (y 0))
  (assert (valid-pointer? texture))
  (check-type width i32+)
  (check-type height i32+)
  (check-type data (u32-array (*)))
  (check-type rect (or object null))
  (check-type x i32!-)
  (check-type y i32!-)
  (c:with-foreign-slots ((format (texture-width w) (texture-height h)) texture (:struct texture))
    (assert (= (c:foreign-enum-value 'pixel-format format)
               (c:foreign-enum-value 'pixel-format :rgba8888)))
    (let ((dest-width texture-width)
          (dest-height texture-height)
          (pitch (* width 4)))
      (assert (>= (length data) (* width height)))
      (when rect
        (c:with-foreign-slots ((w h (rect-x x) (rect-y y)) rect (:struct rect))
          (assert (<= 0 rect-x (1- texture-width)))
          (assert (<= 0 rect-y (1- texture-height)))
          (assert (<= (+ rect-x w) texture-width))
          (assert (<= (+ rect-y h) texture-height))
          (setf dest-width w
                dest-height h)))
      (assert (<= (+ x dest-width) width))
      (assert (<= (+ y dest-height) height))
      (sv:with-static-vector (pixels (length data) :element-type 'u32 :initial-contents data)
        (%update-texture texture
                         (or rect (c:null-pointer))
                         (sv:static-vector-pointer pixels :offset (+ (* x 4) (* y pitch)))
                         pitch))
      (values))))

